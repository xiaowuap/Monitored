MONITORED_AGENT_PROTOCOL=grpc
MONITORED_SERVER_URL=https://monitored.example
MONITORED_GRPC_TARGET=10.10.10.18:9443
MONITORED_AGENT_NAME=replace-with-unique-agent-name
MONITORED_AGENT_GRPC_INSECURE=false
# 只在首次配对时设置；成功后删除。私钥由 Agent 本地生成。
MONITORED_AGENT_ENROLLMENT_TOKEN=replace-with-one-time-token
MONITORED_AGENT_CREDENTIAL_FILE=/var/lib/monitored-agent/credentials.json
MONITORED_AGENT_CERT_RENEW_BEFORE=168h
# 兼容旧的静态证书部署时，删除 ENROLLMENT_TOKEN/CREDENTIAL_FILE，并设置：
# MONITORED_AGENT_TLS_CERT_FILE=/etc/monitored/pki/agent.crt
# MONITORED_AGENT_TLS_KEY_FILE=/etc/monitored/pki/agent.key
# MONITORED_AGENT_TLS_CA_FILE=/etc/monitored/pki/ca.crt
# MONITORED_AGENT_TLS_SERVER_NAME=server
MONITORED_AGENT_INTERVAL=10s
MONITORED_SMART_INTERVAL=5m
MONITORED_WAL_PATH=/var/lib/monitored-agent/wal.ndjson
MONITORED_SYS_ROOT=/
MONITORED_DEVICE_ROOT=/dev
MONITORED_ALLOW_ROOT_ACTIONS=false
MONITORED_SYSTEMD_UNITS=
# Allow only Master-cached, same-OS/architecture binaries. The service keeps
# /usr/local/bin writable solely for atomic replacement and preserves .previous.
MONITORED_AGENT_UPDATE_MODE=binary
MONITORED_AGENT_UPDATE_INSTALL_PATH=/usr/local/bin/monitored-agent
MONITORED_AGENT_UPDATE_RESTART_DELAY=5s
