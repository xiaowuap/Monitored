MONITORED_HTTP_ADDR=:8080
MONITORED_HTTP_PORT=8080
MONITORED_GRPC_ADDR=:9443
MONITORED_GRPC_PORT=9443
# Local Compose only. Set false and configure the three files below for mTLS.
MONITORED_GRPC_INSECURE=true
MONITORED_GRPC_CERT_FILE=
MONITORED_GRPC_KEY_FILE=
MONITORED_GRPC_CLIENT_CA_FILE=
MONITORED_WEB_PORT=3000
MONITORED_DATABASE_URL=postgres://monitored:monitored@postgres:5432/monitored?sslmode=disable
MONITORED_REDIS_URL=redis://redis:6379/0
MONITORED_PUBLIC_URL=http://localhost:3000
MONITORED_AGENT_TOKEN=replace-with-a-long-random-value
MONITORED_AGENT_PROTOCOL=grpc
MONITORED_AGENT_GRPC_INSECURE=true
MONITORED_AGENT_TLS_CERT_FILE=
MONITORED_AGENT_TLS_KEY_FILE=
MONITORED_AGENT_TLS_CA_FILE=
MONITORED_AGENT_TLS_SERVER_NAME=
# Master-side persistent cache for direct Agent binary updates.
MONITORED_AGENT_UPDATE_MAX_BYTES=268435456
# Local Agent policy: disabled, binary, docker, or auto.
MONITORED_AGENT_UPDATE_MODE=disabled
MONITORED_AGENT_UPDATE_INSTALL_PATH=
MONITORED_AGENT_DOCKER_RESTART_COMMAND=
# Local hardware collection. Container deployments must explicitly map each
# required host device under MONITORED_DEVICE_ROOT.
MONITORED_SYS_ROOT=/
MONITORED_DEVICE_ROOT=/dev
MONITORED_SMART_INTERVAL=5m
# Requires an enrolled Admin TOTP and root-capable host Agent. Keep disabled by default.
MONITORED_ALLOW_ROOT_ACTIONS=false
# Optional TrueNAS SCALE JSON-RPC supplement (system/pool/disk/temperature).
MONITORED_TRUENAS_ENDPOINT=
MONITORED_TRUENAS_TOKEN=
MONITORED_MASTER_KEY=replace-with-32-or-more-random-bytes
MONITORED_ADMIN_EMAIL=admin@example.com
MONITORED_ADMIN_PASSWORD=change-me-now
MONITORED_AUTH_DISABLED=false
MONITORED_AUTO_MIGRATE=true
MONITORED_POSTGRES_PASSWORD=monitored
# Worker-side direct polling and optional, explicitly invoked LLM providers.
MONITORED_WORKER_INTERVAL=1m
MONITORED_CONNECTION_TIMEOUT=45s
MONITORED_CONNECTION_CONCURRENCY=8
MONITORED_OPENAI_BASE_URL=
MONITORED_OPENAI_API_KEY=
MONITORED_OLLAMA_BASE_URL=
MONITORED_LLM_TOKEN_BUDGET=8000
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_MONITORED_MODE=live
NEXT_PUBLIC_ALLOW_RUNTIME_SWITCH=false
