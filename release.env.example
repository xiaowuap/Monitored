MONITORED_VERSION=0.1.0
MONITORED_DATA_DIR=/var/lib/monitored
MONITORED_CONFIG_DIR=/etc/monitored

# Override these four values when loading locally built or offline images.
MONITORED_SERVER_IMAGE=ghcr.io/xiaowuap/monitored-server
MONITORED_WORKER_IMAGE=ghcr.io/xiaowuap/monitored-worker
MONITORED_WEB_IMAGE=ghcr.io/xiaowuap/monitored-web
MONITORED_AGENT_IMAGE=ghcr.io/xiaowuap/monitored-agent

MONITORED_HTTP_PORT=8080
MONITORED_GRPC_PORT=9443
MONITORED_WEB_PORT=3000
MONITORED_PUBLIC_URL=https://monitored.example
MONITORED_GRPC_PUBLIC_TARGET=monitored.example:9443

MONITORED_POSTGRES_PASSWORD=replace-with-a-random-password
MONITORED_MASTER_KEY=replace-with-32-or-more-random-bytes
MONITORED_AGENT_TOKEN=replace-with-a-long-random-compatibility-token
MONITORED_ADMIN_EMAIL=admin@example.com
MONITORED_ADMIN_PASSWORD=replace-with-a-strong-password
MONITORED_AGENT_UPDATE_MAX_BYTES=268435456

MONITORED_WORKER_INTERVAL=1m
MONITORED_CONNECTION_TIMEOUT=45s
MONITORED_CONNECTION_CONCURRENCY=8
MONITORED_OPENAI_BASE_URL=
MONITORED_OPENAI_API_KEY=
MONITORED_OLLAMA_BASE_URL=
MONITORED_LLM_TOKEN_BUDGET=8000
